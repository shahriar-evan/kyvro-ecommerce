{
  "crons": [
    {
      "path": "/api/plan?action=reminders",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/plan?action=sitemap"
    },
    {
      "source": "/Admin",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/:link([a-z0-9][a-z0-9-]{1,38}[a-z0-9])",
      "destination": "/"
    }
  ]
}
